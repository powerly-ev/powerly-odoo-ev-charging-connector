<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerly_orders_feedback_tree" model="ir.ui.view">
        <field name="name">powerly.orders.feedback.tree</field>
        <field name="model">powerly.orders.feedback</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="feedback_id"/>
                <field name="message"/>
                <field name="rating"/>
                <field name="charger_id"/>
                <field name="feedback_date"/>
            </list>
        </field>
    </record>

    <record id="view_powerly_orders_feedback_form" model="ir.ui.view">
        <field name="name">powerly.orders.feedback.form</field>
        <field name="model">powerly.orders.feedback</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <field name="feedback_id"/>
                        <field name="charge_point_order_id"/>
                        <field name="title"/>
                        <field name="charger_id"/>
                        <field name="rating"/>
                        <field name="feedback_date"/>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_powerly_orders_feedback" model="ir.actions.act_window">
        <field name="name">Orders Feedback</field>
        <field name="res_model">powerly.orders.feedback</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_powerly_orders_feedback" name="Orders Feedback" parent="menu_powerly_charger_root" action="action_powerly_orders_feedback" sequence="30"/>
</odoo>
