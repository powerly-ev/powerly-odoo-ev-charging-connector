<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_add_powerly_api_key_field" model="ir.ui.view">
        <field name="name">view_company_form_add_powerly_api_key_field</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="after">
                <page string="Powerly" name="powerly">
                    <div class="alert alert-success" invisible="not powerly_bearer_token">Connection Established with Powerly</div>
                    <group>
                        <group>
                            <field name="powerly_username" />
                            <field name="powerly_password" password="true" />
                            <field name="powerly_base_url"/>
                            <field name="powerly_partner_id" invisible="not powerly_bearer_token" />
                        </group>
                        <group>
                            <field name="powerly_api_key" password="true"/>
                            <field name="powerly_webhook_secret_key" password="true"/>
                        </group>
                        <group>
                            <button string="Get Token" name="set_powerly_details" type="object" class="btn-primary"/>
                            <field name="powerly_bearer_token" invisible="1" />
                            <field name="is_subscribed" invisible="1"/>
                            <field name="subscription_features" invisible="1"/>
                            <field name="subscription_ends" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
